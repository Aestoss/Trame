rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // The server only ever talks to Firestore via firebase-admin, which
    // bypasses these rules entirely -- there is no client-side Firestore
    // access in this app. Deny-by-default is just the honest declaration of
    // that, not a rule anything actually needs to pass.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
